# Neon / Vercel Postgres connection string
# Vercel's Neon integration uses STORAGE_POSTGRES_URL; manual setup uses POSTGRES_URL
POSTGRES_URL=postgres://user:password@host/database?sslmode=require

# Widget API key (comma-separated for key rotation)
API_KEY=gk_replace_me

# Vercel cron job authentication secret
CRON_SECRET=cs_replace_me
